# Copy to .env and fill in real values for local development.
# Loaded automatically by springboot3-dotenv (pom.xml) — never commit the real .env file.
#
# Profile switching does NOT belong in this file: Spring Boot decides which profile is active
# earlier in startup than .env gets loaded, so a SPRING_PROFILES_ACTIVE line here is silently
# ignored (confirmed the hard way — it fell through to the default/MySQL profile instead).
# `mvn spring-boot:run` with zero flags already runs as "dev" (file-based H2, no MySQL needed) —
# see `spring.profiles.default: dev` in application.yml. To run as the default/prod profile
# instead (e.g. to test against a real local MySQL), override it explicitly:
#   mvn spring-boot:run "-Dspring-boot.run.profiles=default"

# MySQL credentials (default/prod profile only — irrelevant for the "dev" H2 profile).
DB_USERNAME=root
DB_PASSWORD=root

# JWT signing secret — must be a long random string in any real deployment.
JWT_SECRET=change-this-to-a-long-random-secret-in-production-please

# Comma-separated list of origins allowed to call the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Unused at runtime — every real LLM call is built per-request from the caller's own key
# (see PerRequestChatClientFactory / PLAN.md §8). Spring AI's autoconfiguration just requires
# *some* value to be present here.
OPENAI_API_KEY=placeholder

# Dev-only (AdminSeeder, "dev" profile only): on startup, promotes this already-registered user
# to ADMIN. Leave blank to skip. Has no effect on the default/prod profile.
APP_SEED_ADMIN_EMAIL=
